generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  nama         String
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  berita Berita[]
}

model Berita {
  id          Int          @id @default(autoincrement())
  judul       String
  slug        String       @unique
  ringkasan   String
  isi         String       @db.Text
  gambarUrl   String?
  published   Boolean      @default(false)
  publishedAt DateTime?
  authorId    Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author Admin?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  foto   BeritaFoto[]
}

model BeritaFoto {
  id        Int      @id @default(autoincrement())
  url       String
  caption   String?
  urutan    Int      @default(0)
  beritaId  Int
  createdAt DateTime @default(now())

  berita Berita @relation(fields: [beritaId], references: [id], onDelete: Cascade)
}

model Fasilitas {
  id        Int             @id @default(autoincrement())
  nama      String
  deskripsi String          @db.Text
  gambarUrl String?
  urutan    Int             @default(0)
  aktif     Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  foto FasilitasFoto[]
}

model FasilitasFoto {
  id          Int       @id @default(autoincrement())
  url         String
  caption     String?
  urutan      Int       @default(0)
  fasilitasId Int
  createdAt   DateTime  @default(now())

  fasilitas Fasilitas @relation(fields: [fasilitasId], references: [id], onDelete: Cascade)
}

model Guru {
  id        Int         @id @default(autoincrement())
  nama      String
  jabatan   String
  fotoUrl   String?
  bio       String?     @db.Text
  urutan    Int         @default(0)
  aktif     Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  foto GuruFoto[]
}

model GuruFoto {
  id        Int      @id @default(autoincrement())
  url       String
  caption   String?
  urutan    Int      @default(0)
  guruId    Int
  createdAt DateTime @default(now())

  guru Guru @relation(fields: [guruId], references: [id], onDelete: Cascade)
}

model Prestasi {
  id        Int            @id @default(autoincrement())
  judul     String
  deskripsi String?        @db.Text
  tahun     Int
  tingkat   String?
  gambarUrl String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  foto PrestasiFoto[]
}

model PrestasiFoto {
  id         Int      @id @default(autoincrement())
  url        String
  caption    String?
  urutan     Int      @default(0)
  prestasiId Int
  createdAt  DateTime @default(now())

  prestasi Prestasi @relation(fields: [prestasiId], references: [id], onDelete: Cascade)
}

model Kegiatan {
  id        Int            @id @default(autoincrement())
  judul     String
  deskripsi String         @db.Text
  tanggal   DateTime
  lokasi    String?
  gambarUrl String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  foto KegiatanFoto[]
}

model KegiatanFoto {
  id         Int      @id @default(autoincrement())
  url        String
  caption    String?
  urutan     Int      @default(0)
  kegiatanId Int
  createdAt  DateTime @default(now())

  kegiatan Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
}

model ProgramAkademik {
  id        Int      @id @default(autoincrement())
  judul     String
  slug      String   @unique
  ringkasan String
  isi       String   @db.Text
  gambarUrl String?
  unggulan  Boolean  @default(false)
  aktif     Boolean  @default(true)
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ekstrakurikuler {
  id            Int      @id @default(autoincrement())
  nama          String
  slug          String   @unique
  deskripsi     String
  tujuan        String   @db.Text
  kegiatanRutin String   @db.Text
  fasilitas     String   @db.Text
  jumlahAnggota Int?
  ikon          String   @default("sains")
  aktif         Boolean  @default(true)
  urutan        Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
